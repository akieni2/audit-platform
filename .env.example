# Email de secours pour alertes nouvelles demandes d'enrôlement (si aucun super_admin actif)
# DGCPT_ENROLLMENT_ALERT_EMAIL=

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Politique mot de passe (optionnel — défaut : 8 caractères min., sans complexité obligatoire)
# DGCPT_PASSWORD_MIN_LENGTH=8
# DGCPT_PASSWORD_MIXED_CASE=false
# DGCPT_PASSWORD_NUMBERS=false
# DGCPT_PASSWORD_SYMBOLS=false
# true = vérifie les mots de passe contre Have I Been Pwned (HTTPS sortant requis)
# DGCPT_PASSWORD_UNCOMPROMISED=true

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Temps réel — production : reverb + php artisan reverb:start (voir deploy/supervisor/reverb.example.conf)
BROADCAST_CONNECTION=log
REVERB_APP_ID=audit-platform
REVERB_APP_KEY=local-key-change-me
REVERB_APP_SECRET=local-secret-change-me
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Production : redis + Horizon / workers Supervisés
# QUEUE_CONNECTION=redis

CACHE_STORE=database

# KPI nationaux (ExecutiveDashboardService) — secondes
EXEC_KPI_CACHE_TTL=120

# PDF mission : true = job async → storage/app/reports (voir GenerateMissionPdfJob)
QUEUE_MISSION_PDF=false
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Copilote OpenAI — conserver la clé uniquement dans le .env du serveur.
AI_COPILOT_ENABLED=true
AI_COPILOT_DRIVER=stub
AI_COPILOT_MAX_TOKENS=2048
AI_COPILOT_CONTEXT_MAX_CHARS=20000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_TIMEOUT=90
OPENAI_CONNECT_TIMEOUT=10
OPENAI_RETRY_TIMES=2
# false évite de demander la conservation distante des réponses.
OPENAI_STORE_RESPONSES=false